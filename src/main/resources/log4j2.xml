<Configuration>
    <Appenders>
        <Console name="myConsole" target="STDOUT">
            <PatternLayout pattern="%d %-5p [%t] %C{2} - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="org.apache.log4j.xml" level="info"/>
        <Root level="info">
            <AppenderRef ref="myConsole"/>
        </Root>
    </Loggers>
</Configuration>